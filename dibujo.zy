// ============================================================
// dibujo.zy — renderizado: tablero, serpiente, comida, marcador, pantallas
//
// Toda salida va directo a la terminal via >>~ (ANSI posicionado).
// Sin valores de retorno — efectos de lado puros. comida es una
// tupla plana (fila, col); fruta es el string emoji pasado por
// separado.
//
// Ninguna cadena visible se escribe aquí: todas vienen de
// idioma/despacho, que guarda el idioma activo como estado de
// módulo. Por eso ninguna función de este archivo lleva un
// parámetro de idioma, y por eso el juego puede cambiar de idioma
// sin desmontar la pila de llamadas.
//
// Ningún ancho se teclea aquí tampoco. Las cuatro pantallas se
// construyen con marco::construir a partir del texto ya traducido,
// y el marcador se centra midiéndolo. Antes eran literales de
// ancho fijo con el relleno contado a mano; ver
// AUDITORIA_I18N_ES.md, SRP-I18N-002 y SRP-I18N-003.
//
// EN: dibujo.zy — rendering. No visible string and no width is
// written here: strings come from idioma/despacho (locale held as
// module state, so no function takes a language parameter) and
// frames are built from measured content.
// ============================================================

# dibujo {

    <# ./idioma/despacho => idioma
    <# ./texto => txt
    <# ./marco => marco

    #> { menu_velocidad, dibujar_inicio, dibujar, fin_juego, pausa }

    // Índices de color ANSI 256
    BORDE  := 8    // gris oscuro  — paredes del borde
    VERDE  := 10   // verde claro  — cuerpo de la serpiente
    CABEZA := 2    // verde oscuro — cabeza de la serpiente
    COMIDA := 11   // amarillo     — comida / acento marcador
    ROJO   := 9    // rojo vivo    — fin de juego / infernal
    TEXTO  := 15   // blanco       — texto general

    // Construye una línea horizontal de n copias de "─"
    _linea_h(n) {
        <~ "─" $* n
    }

    // Dirección de un punto hacia otro: 'R' 'L' 'U' 'D'
    _dir_hacia(origen, destino) {
        [or, oc] = origen
        [dr, dc] = destino
        ? dc > oc { <~ 'R' }
        ? dc < oc { <~ 'L' }
        ? dr < or { <~ 'U' }
        <~ 'D'
    }

    // Carácter de cabeza según dirección de movimiento
    _char_cabeza(cab, cuerpo) {
        d = _dir_hacia(cuerpo, cab)
        ? d == 'R' { <~ "▶" }
        ? d == 'L' { <~ "◀" }
        ? d == 'U' { <~ "▲" }
        <~ "▼"
    }

    // Carácter de cuerpo según los dos segmentos vecinos (ant = hacia cabeza, sig = hacia cola)
    _char_cuerpo(ant, pos, sig) {
        da = _dir_hacia(pos, ant)
        ds = _dir_hacia(pos, sig)
        ? (da == 'R' && ds == 'L') || (da == 'L' && ds == 'R') { <~ "─" }
        ? (da == 'U' && ds == 'D') || (da == 'D' && ds == 'U') { <~ "│" }
        ? (da == 'R' && ds == 'D') || (da == 'D' && ds == 'R') { <~ "╭" }
        ? (da == 'L' && ds == 'D') || (da == 'D' && ds == 'L') { <~ "╮" }
        ? (da == 'R' && ds == 'U') || (da == 'U' && ds == 'R') { <~ "╰" }
        <~ "╯"
    }

    // Carácter de cola: extremo libre, sigue la dirección del segmento anterior
    _char_cola(penultimo, cola) {
        d = _dir_hacia(penultimo, cola)
        ? d == 'R' || d == 'L' { <~ "─" }
        <~ "│"
    }

    // ── ayudas de composición ────────────────────────────────

    // Dibuja las filas de un marco ya construido, empezando en
    // (fila0, col0). `colores` es paralelo a `filas`: un índice de
    // color ANSI por fila.
    //
    // EN: Draw the rows of a built frame from (fila0, col0).
    // `colores` runs parallel to `filas`, one ANSI index per row.
    _pintar(filas, colores, fila0, col0) {
        i = 1
        @ i <= (filas$#) {
            >>~ (fila0 + i - 1, col0, 0, colores[i]) > filas[i]
            i++
        }
    }

    // Coloca un marco centrado en el interior del tablero y
    // devuelve su esquina superior izquierda. El interior va de la
    // fila 2 a la AL+1 y de la columna 2 a la AN+1.
    //
    // EN: Centre a frame inside the board and return its top-left
    // corner. The interior spans rows 2..AL+1, columns 2..AN+1.
    _esquina(filas, AN, AL) {
        ancho = txt::ancho(filas[1])
        alto  = filas$#
        <~ (2 + (AL - alto) / 2, 2 + (AN - ancho) / 2)
    }

    // Un array de `n` copias del color `c`, para los marcos en los
    // que todas las filas van del mismo color.
    // EN: `n` copies of colour `c`, for single-colour frames.
    _un_color(n, c) {
        salida = []
        i = 1
        @ i <= n {
            salida = salida $+ c
            i++
        }
        <~ salida
    }

    // Dibuja el marcador de puntos centrado sobre el borde superior
    // (fila 1), superpuesto a los "─" del borde.
    //
    // La versión anterior escribía " ✦ PUNTOS " y colocaba las
    // cinco piezas con los desplazamientos -7, +1, +10, +12 y +15,
    // derivados de la longitud de esa cadena en español y del
    // supuesto de que el puntaje cabe en dos dígitos. Ahora el
    // idioma compone la insignia entera y aquí solo se mide y se
    // centra, así que vale para "SCORE", para cuatro dígitos y para
    // un idioma de columnas dobles.
    //
    // EN: The score badge over the top border. It used to be five
    // pieces placed with offsets derived from the length of the
    // Spanish word and from the assumption that the score fits in
    // two digits. The locale now composes the whole badge and this
    // only measures and centres it.
    _marcador(puntos, AN) {
        insignia = idioma::marcador(puntos)
        ancho = txt::ancho(insignia)
        col = (AN + 2 - ancho) / 2 + 1
        >>~ (1, col - 1, 0, BORDE) > "┤"
        >>~ (1, col, 0, COMIDA) > insignia
        >>~ (1, col + ancho, 0, BORDE) > "├"
    }

    // Menú de selección de velocidad — retorna retardo en ms
    // (160/130/100/70/40).
    //
    // El menú es datos, no dibujo: una lista de etiquetas y sus
    // retardos. Antes eran diez literales —cinco opciones en dos
    // estados— con el relleno tecleado, y traducirlos descuadraba
    // la caja. Ahora la marca "►" se pone antes de medir, de modo
    // que el marco tiene sitio para ella en cualquier idioma y las
    // filas no se mueven al mover el cursor.
    //
    // EN: Speed menu — returns the delay in ms. The menu is data,
    // not drawing code. The "►" marker goes on before measuring, so
    // the frame has room for it in every language and the rows
    // never shift when the cursor moves.
    menu_velocidad(AN, AL) {
        >>!
        sel = 1
        retardos = [160, 130, 100, 70, 40]

        @:sel {
            etiquetas = [
                idioma::texto("menú.lento"),
                idioma::texto("menú.normal"),
                idioma::texto("menú.rápido"),
                idioma::texto("menú.infernal"),
                idioma::texto("menú.demencial")
            ]

            líneas = [
                marco.CENTRADO $+ idioma::texto("menú.título1"),
                marco.CENTRADO $+ idioma::texto("menú.título2"),
                marco.SEPARADOR,
                idioma::texto("menú.velocidad"),
                ""
            ]
            i = 1
            @ i <= 5 {
                fila = marco::fila_menú(i, etiquetas[i], i == sel)
                ms = retardos[i]
                líneas = líneas $+ (txt::derecha(fila, 18) $+ " {ms} ms")
                i++
            }

            // El idioma se puede cambiar aquí mismo, sin salir del
            // juego. Es lo que hace que `snake.zy` sea una comodidad
            // y no el único camino: quien arranca `serpiente.zy` y no
            // lee español no tendría por qué saber que existe el otro
            // archivo.
            //
            // EN: The language can be changed right here, without
            // leaving the game. It is what makes `snake.zy` a
            // convenience rather than the only route.
            líneas = líneas $+ marco.SEPARADOR
            líneas = líneas $+ ("  [L]  " $+ idioma::texto("menú.idioma") $+ ": " $+ idioma::texto("idioma.nombre"))

            filas = marco::construir(líneas, 3)
            // Colores: dos bordes fuera, y dentro un color por
            // línea de contenido. Las dos últimas opciones tienen
            // acento propio, y la seleccionada gana a todo.
            // EN: two border rows outside, one colour per content
            // line inside; the selected row wins over the accents.
            colores = [TEXTO, TEXTO, TEXTO, TEXTO, COMIDA, TEXTO]
            i = 1
            @ i <= 5 {
                c = TEXTO
                ? i == 4 { c = ROJO }
                ? i == 5 { c = 201 }
                ? i == sel { c = VERDE }
                colores = colores $+ c
                i++
            }
            colores = colores $+ TEXTO $+ TEXTO $+ COMIDA

            [fila0, col0] = _esquina(filas, AN, AL)
            _pintar(filas, colores, fila0, col0)

            <<| tecla
            ? tecla == 'l' || tecla == 'L' {
                idioma::rotar()
                >>!
            }
            ? tecla == '1' { <~ retardos[1] }
            ? tecla == '2' { <~ retardos[2] }
            ? tecla == '3' { <~ retardos[3] }
            ? tecla == '4' { <~ retardos[4] }
            ? tecla == '5' { <~ retardos[5] }
            ? tecla == '\n' { <~ retardos[sel] }

            sel = _mover_sel(tecla, sel, 5)
        }
    }

    // Pantalla de ayuda — controles e instrucciones. Espera
    // cualquier tecla y retorna.
    //
    // El texto largo de la explicación venía partido a mano en tres
    // filas para caber en 30 columnas. Ahora las dos líneas son
    // claves independientes y el marco se ajusta a la más ancha del
    // idioma activo.
    //
    // EN: Help screen. The long explanation used to be split by
    // hand across three rows to fit 30 columns; the two lines are
    // now separate keys and the frame fits the widest.
    _ayuda(AN, AL) {
        >>!
        líneas = [
            marco.CENTRADO $+ idioma::texto("ayuda.título"),
            marco.SEPARADOR,
            idioma::texto("ayuda.movimiento"),
            "  W / ↑   — " $+ idioma::texto("ayuda.arriba"),
            "  S / ↓   — " $+ idioma::texto("ayuda.abajo"),
            "  A / ←   — " $+ idioma::texto("ayuda.izquierda"),
            "  D / →   — " $+ idioma::texto("ayuda.derecha"),
            "",
            idioma::texto("ayuda.enPartida"),
            "  Q       — " $+ idioma::texto("ayuda.salir"),
            "  P       — " $+ idioma::texto("ayuda.pausar"),
            "",
            idioma::texto("ayuda.crecer1"),
            idioma::texto("ayuda.crecer2")
        ]

        filas = marco::construir(líneas, 2)
        colores = [CABEZA, CABEZA, CABEZA, COMIDA, TEXTO, TEXTO, TEXTO,
                   TEXTO, TEXTO, COMIDA, TEXTO, TEXTO, TEXTO, COMIDA,
                   COMIDA, CABEZA]

        [fila0, col0] = _esquina(filas, AN, AL)
        _pintar(filas, colores, fila0, col0)
        >>~ (fila0 + (filas$#) + 1, col0, 0, TEXTO) > idioma::texto("ayuda.continuar")
        <<| _tecla_cualquiera
    }

    // Pausa — dibuja un panel centrado y bloquea hasta que se
    // vuelva a presionar P.
    // EN: Pause panel; blocks until P is pressed again.
    pausa(AN, AL) {
        líneas = [
            "",
            marco.CENTRADO $+ idioma::texto("pausa.título"),
            "",
            "  [P]  " $+ idioma::texto("pausa.continuar")
        ]
        filas = marco::construir(líneas, 2)
        colores = _un_color(filas$#, TEXTO)

        [fila0, col0] = _esquina(filas, AN, AL)
        _pintar(filas, colores, fila0, col0)

        @:espera {
            <<| tecla
            ? tecla == 'p' || tecla == 'P' { @:espera! }
        }
    }

    // Dibuja el primer frame completo: borde, serpiente, comida, marcador
    dibujar_inicio(serpiente, comida, fruta, puntos, AN, AL) {
        >>!

        // Bordes exterior
        >>~ (1, 1, 0, BORDE) > "╭" _linea_h(AN) "╮"
        >>~ (AL + 2, 1, 0, BORDE) > "╰" _linea_h(AN) "╯"

        fila = 2
        @ fila <= AL + 1 {
            >>~ (fila, 1, 0, BORDE) > "│"
            >>~ (fila, AN + 2, 0, BORDE) > "│"
            fila++
        }

        // Marcador sobre el borde superior — siempre dentro de la pantalla
        _marcador(puntos, AN)

        // Comida
        [fy, fx] = comida
        >>~ (fy, fx, 0, COMIDA) > fruta

        // Cabeza
        [hy, hx] = serpiente[1]
        >>~ (hy, hx, 0, CABEZA) > _char_cabeza(serpiente[1], serpiente[2])

        // Cuerpo (segmentos 2..lon-1)
        lon = serpiente$#
        i = 2
        @ i < lon {
            [sy, sx] = serpiente[i]
            >>~ (sy, sx, 0, VERDE) > _char_cuerpo(serpiente[i-1], serpiente[i], serpiente[i+1])
            i++
        }

        // Cola
        [ty, tx] = serpiente[lon]
        >>~ (ty, tx, 0, VERDE) > _char_cola(serpiente[lon-1], serpiente[lon])
    }

    // Renderizado delta: solo actualiza las celdas que cambiaron en el último tick
    // comio:  fruta desaparece, movimiento normal de cola, sin @ todavía
    // crecer: @ aparece en pos_arroba (panza), cola se queda en su lugar
    // normal: vieja cabeza → cuerpo, cola se elimina y redibuja
    dibujar(serpiente, cola_vieja, crecer, comio, comida_vieja, comida, fruta, puntos, AN, AL, pos_arroba) {
        [fy_cab, fx_cab] = serpiente[1]

        ? comio {
            // Tick de comer: fruta desaparece, movimiento normal (cola sale), nueva comida aparece
            [fvy, fvx] = comida_vieja
            >>~ (fvy, fvx, 0, 0) > "  "
            ? serpiente$# >= 3 {
                [py2, px2] = serpiente[2]
                >>~ (py2, px2, 0, 10) > _char_cuerpo(serpiente[1], serpiente[2], serpiente[3])
            }
            [ty, tx] = cola_vieja
            >>~ (ty, tx, 0, 0) > " "
            lon = serpiente$#
            [nty, ntx] = serpiente[lon]
            >>~ (nty, ntx, 0, 10) > _char_cola(serpiente[lon-1], serpiente[lon])
            [fy, fx] = comida
            >>~ (fy, fx, 0, 11) > fruta
        }

        ? crecer {
            // Tick de crecimiento: @ en la panza donde estaba la fruta, cola se queda
            [ay, ax] = pos_arroba
            >>~ (ay, ax, 0, 11) > "@"
        }

        ? !comio && !crecer {
            // Tick normal: vieja cabeza → cuerpo, cola sale y se redibuja
            ? serpiente$# >= 3 {
                [py2, px2] = serpiente[2]
                >>~ (py2, px2, 0, 10) > _char_cuerpo(serpiente[1], serpiente[2], serpiente[3])
            }
            [ty, tx] = cola_vieja
            >>~ (ty, tx, 0, 0) > " "
            lon = serpiente$#
            [nty, ntx] = serpiente[lon]
            >>~ (nty, ntx, 0, 10) > _char_cola(serpiente[lon-1], serpiente[lon])
        }

        >>~ (fy_cab, fx_cab, 0, 2) > _char_cabeza(serpiente[1], serpiente[2])
        _marcador(puntos, AN)
    }

    // Mueve el cursor del selector — wrap circular entre 1 y max
    _mover_sel(tecla, sel, max) {
        ? tecla == '↑' { ? sel > 1 { <~ sel - 1 } <~ max }
        ? tecla == '↓' { ? sel < max { <~ sel + 1 } <~ 1 }
        <~ sel
    }

    // Pantalla de fin de juego — selector con ↑↓ y ↵ para
    // confirmar. Las teclas N/S/A siguen funcionando, pero son
    // atajos del **español**: quedan como estaban a propósito, y
    // por eso las etiquetas del menú llevan también su inicial
    // entre corchetes en el idioma que sea. Un atajo que cambia de
    // tecla al cambiar de idioma es peor que un atajo fijo.
    //
    // partidas y marcadores vienen acumulados con ° en serpiente.zy
    // — retorna 'n' o 's'.
    //
    // EN: Game-over screen. N/S/A still work but they are Spanish
    // mnemonics, kept fixed on purpose: a shortcut that moves when
    // the language changes is worse than one that does not.
    fin_juego(puntos, partidas, marcadores, AN, AL) {
        // Deriva el record del historial de puntajes de la sesión
        record = 0
        @ i:1..marcadores$# {
            ? marcadores[i] > record { record = marcadores[i] }
        }

        sel = 1

        @:menu {
            >>!
            etiquetas = [
                idioma::texto("fin.nuevo"),
                idioma::texto("fin.salir"),
                idioma::texto("fin.ayuda")
            ]

            marca_p = idioma::texto("fin.puntaje")
            marca_r = idioma::texto("fin.récord")

            líneas = [
                marco.CENTRADO $+ idioma::texto("fin.título1"),
                marco.CENTRADO $+ idioma::texto("fin.título2"),
                marco.SEPARADOR,
                "{marca_p}: {puntos}    {marca_r}: {record}",
                idioma::texto_partida(partidas),
                ""
            ]
            // El fin de partida también acepta [L]: es donde se
            // vuelve entre partida y partida.
            // EN: the game-over screen takes [L] too — it is where
            // you land between games.
            i = 1
            @ i <= 3 {
                marca = "  "
                ? i == sel { marca = "► " }
                líneas = líneas $+ (marca $+ etiquetas[i])
                i++
            }

            filas = marco::construir(líneas, 3)
            colores = [ROJO, ROJO, ROJO, ROJO, TEXTO, TEXTO, TEXTO]
            i = 1
            @ i <= 3 {
                c = TEXTO
                ? i == sel { c = VERDE }
                colores = colores $+ c
                i++
            }
            colores = colores $+ ROJO

            [fila0, col0] = _esquina(filas, AN, AL)
            _pintar(filas, colores, fila0, col0)

            <<| tecla

            ? tecla == 'n' || tecla == 'N' { <~ 'n' }
            ? tecla == 's' || tecla == 'S' { <~ 's' }
            ? tecla == 'l' || tecla == 'L' { idioma::rotar() }
            ? tecla == 'a' || tecla == 'A' { _ayuda(AN, AL) }
            ? tecla == '\n' {
                ? sel == 1 { <~ 'n' }
                ? sel == 2 { <~ 's' }
                ? sel == 3 { _ayuda(AN, AL) }
            }

            sel = _mover_sel(tecla, sel, 3)
        }
    }
}
