// ============================================================
// idioma/despacho.zy — el despachador de idioma
//
// Toda cadena que ve el jugador pasa por aquí, y solo por aquí.
// El idioma activo vive como estado del módulo: el estado se
// comparte por ruta de archivo, así que cualquier módulo que
// importe este ve la misma selección sin que nadie tenga que
// pasar un parámetro de idioma por la cadena de llamadas.
//
// Las claves están en español, porque el programa está escrito en
// español. El español es la base y los demás idiomas se apoyan
// sobre ella: cuando dibujo.zy pide "menú.velocidad" está pidiendo
// un concepto en español, no un identificador neutro en inglés.
//
// Cada clave lleva prefijo de dominio ("menú.título", nunca
// "título"). Así una clave no puede coincidir nunca con su propia
// traducción al español, y eso es lo que hace que la comprobación
// «traducción == clave ⇒ falta» siga siendo decidible también en
// el idioma base.
//
// Añadir un idioma son tres ediciones: escribir idioma/<nombre>.zy
// contra el contrato de cuatro funciones, importarlo aquí y añadir
// una rama a cada reparto. pruebas/verificación_idioma.zy lo
// comprueba después clave por clave.
//
// EN: idioma/despacho.zy — i18n dispatcher. Single entry point for
// every user-visible string. The active locale is module state,
// shared per file path, so no render function carries a language
// parameter. Keys are Spanish — the base language of the program —
// and every key has a domain prefix so that a key can never equal
// its own Spanish translation.
// ============================================================

# .idioma_despacho {

    <# ./español => es
    <# ./english => en

    #> {
        fijar
        actual
        rotar
        idiomas
        claves
        texto
        marcador
        texto_partida
    }

    idioma_actual = "es"

    // Códigos ISO 639-1. El código es un convenio internacional y
    // no se traduce. El español va primero porque el programa está
    // escrito en español.
    //
    // EN: ISO 639-1 codes — an international convention, left as
    // they are. Spanish leads because the program is written in it.
    idiomas() { <~ ["es", "en"] }

    fijar(código) { idioma_actual = código }
    actual() { <~ idioma_actual }

    // Pasa al siguiente idioma de la lista, dando la vuelta al
    // llegar al final. Lo usa la pantalla de inicio para que el
    // idioma se pueda cambiar desde dentro del juego y no solo
    // eligiendo con qué archivo se arranca — que es justo lo que no
    // sirve a quien no sabe leer el idioma en curso.
    //
    // EN: Advance to the next locale, wrapping around. The setup
    // screen uses it so the language can be changed from inside the
    // game and not only by choosing which file to launch — which is
    // no use to whoever cannot read the language it is currently in.
    // Rotar son dos funciones y no una: una pura que calcula y otra
    // sin valor de retorno que escribe.
    //
    // Empezó siendo el rodeo de HLZ-SRP-001 —el tree-walker perdía la
    // escritura cuando una función de módulo escribía estado y además
    // devolvía un valor con `<~`— y se queda ahora que está corregido,
    // porque aquel fallo era silencioso: con un binario v0.0.8 sin el
    // arreglo, la versión de una sola función no da error, deja el
    // idioma anterior y sigue. Separar el cálculo del efecto es además
    // buena forma por sí sola.
    //
    // EN: Two functions rather than one — a pure one computes, a void
    // one writes. It started as the workaround for HLZ-SRP-001 (the
    // tree-walker dropped the write when a module function both wrote
    // state and returned a value) and stays now that it is fixed,
    // because that failure was silent: on an unfixed v0.0.8 binary the
    // single-function version does not error, it just leaves the old
    // locale in place. Separating the computation from the effect is
    // good shape regardless.
    _siguiente() {
        lista = idiomas()
        n = lista$#
        pos = 0
        i = 1
        @ i <= n {
            ? lista[i] == idioma_actual { pos = i }
            i++
        }
        ? pos == 0 || pos == n { pos = 0 }
        <~ lista[pos + 1]
    }

    rotar() { fijar(_siguiente()) }

    texto(clave) {
        ? idioma_actual == "en" { <~ en::texto(clave) }
        <~ es::texto(clave)
    }

    // El marcador que va sobre el borde superior durante la
    // partida. Se compone entero aquí porque dibujo.zy lo centra
    // midiéndolo, y para eso tiene que ser una sola cadena.
    //
    // EN: The badge drawn over the top border during play. It is
    // composed whole here because dibujo.zy centres it by measuring
    // it, which needs it to be one string.
    marcador(puntos) {
        ? idioma_actual == "en" { <~ en::marcador(puntos) }
        <~ es::marcador(puntos)
    }

    // "Partida 3 de la sesión" / "Game 3 of this session".
    // Es una frase con un número dentro, así que la compone cada
    // idioma; una tabla estática no puede.
    //
    // EN: A sentence with a number in it, so each locale composes
    // it. A static table cannot.
    texto_partida(n) {
        ? idioma_actual == "en" { <~ en::texto_partida(n) }
        <~ es::texto_partida(n)
    }

    // Catálogo maestro de claves. Es el contrato que todo idioma
    // tiene que cumplir, y pruebas/verificación_idioma.zy lo
    // recorre contra todos los idiomas registrados avisando de
    // cualquier clave que caiga en el caso identidad.
    //
    // EN: The master key catalogue — the contract every locale must
    // satisfy, walked by pruebas/verificación_idioma.zy.
    claves() {
        <~ [
            "idioma.nombre",
            "menú.título1", "menú.título2", "menú.velocidad", "menú.idioma",
            "menú.lento", "menú.normal", "menú.rápido",
            "menú.infernal", "menú.demencial",
            "ayuda.título", "ayuda.movimiento", "ayuda.arriba",
            "ayuda.abajo", "ayuda.izquierda", "ayuda.derecha",
            "ayuda.enPartida", "ayuda.salir", "ayuda.pausar",
            "ayuda.crecer1", "ayuda.crecer2", "ayuda.continuar",
            "pausa.título", "pausa.continuar",
            "fin.título1", "fin.título2", "fin.puntaje",
            "fin.récord", "fin.nuevo", "fin.salir", "fin.ayuda",
            "marcador.puntos"
        ]
    }
}
